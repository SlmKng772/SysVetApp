<?xml version="1.0" encoding="utf-8" ?>
<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="SysVetApp.Components.CampoSelecao"
             x:Name="raiz">

    <!--
        COMPONENTIZAÇÃO.
        Rótulo + Picker (lista suspensa) num componente só.
        É o que permite escolher a ESPÉCIE e o CLIENTE no formulário de Animal,
        sem repetir o bloco duas vezes.
    -->
    <VerticalStackLayout Spacing="4" Margin="0,0,0,12">

        <Label Text="{Binding Titulo, Source={x:Reference raiz}}"
               FontSize="13"
               FontAttributes="Bold"
               TextColor="{StaticResource CorPrimaria}" />

        <Border Stroke="{StaticResource CorBordaCampo}"
                StrokeThickness="1"
                BackgroundColor="{StaticResource CorCampoFundo}"
                Padding="10,0">
            <Border.StrokeShape>
                <RoundRectangle CornerRadius="8" />
            </Border.StrokeShape>

            <Picker x:Name="seletor"
                    Title="{Binding Dica, Source={x:Reference raiz}}"
                    ItemsSource="{Binding Itens, Source={x:Reference raiz}}"
                    SelectedItem="{Binding ItemSelecionado, Source={x:Reference raiz}, Mode=TwoWay}"
                    FontSize="15"
                    TextColor="{StaticResource CorTexto}"
                    TitleColor="{StaticResource CorTextoFraco}"
                    BackgroundColor="Transparent" />
        </Border>

    </VerticalStackLayout>

</ContentView>
